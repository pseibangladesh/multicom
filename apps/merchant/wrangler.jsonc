{
  "name": "merchant",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "MERCHANT",
        "class_name": "MerchantDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MerchantDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "multicom_db",
      "database_name": "multicom-db",
      "database_id": "ab0ab360-8118-4487-8773-dbc2cefb526a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "multicom-images"
    },
    {
      "binding": "DIGITAL_ASSETS_BUCKET",
      "bucket_name": "multicom-digital-assets"
    }
  ],
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "2fb78ccfe6354987b5dafd81907586da"
		}
	],
  "vars": {
    "IMAGES_URL": ""
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "dev": {
    "port": 8787
  }
}
