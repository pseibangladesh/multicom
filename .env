# === REQUIRED: Storage & Caching ===
CRYPTOKEN=<32+ char hex string>               # AES-GCM encryption for secrets at rest
ORDER_TOKEN_SECRET=<32+ char random string>   # HMAC secret for order view tokens

# === REQUIRED (production): Stripe ===
STRIPE_SECRET_KEY=sk_live_<your-stripe-key>
STRIPE_PUBLISHABLE_KEY=pk_live_<your-publishable-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# === OPTIONAL: Email (Mailgun) ===
MAILGUN_USER=<your-mailgun-user>
MAILGUN_API_KEY=<your-mailgun-api-key>
MAILGUN_DOMAIN=<your-mailgun-domain>
MAILGUN_BASE_URL=https://api.mailgun.net

# === OPTIONAL: AI Translation ===
AI_API_KEY=<your-groq-or-openai-api-key>
AI_MODEL=llama-3.3-70b-versatile
AI_API_URL=https://api.groq.com/openai/v1

# === OPTIONAL: Store Identity ===
STORE_NAME=My Store
STORE_URL=http://localhost:5173

# === OPTIONAL: Cloudflare AI Gateway ===
CLOUDFLARE_AIG_TOKEN=<your-cf-aig-token>
DISABLE_CLOUDFLARE_AIG=false

# === OPTIONAL: Cache TTL overrides (defaults in brackets) ===
KV_CACHE_SEARCH_TTL_SECONDS=300
KV_CACHE_REVIEWS_TTL_SECONDS=600
KV_CACHE_DEFAULT_TTL_SECONDS=3600

# === CORS & Frontend ===
CORS_ORIGIN=http://localhost:5173

